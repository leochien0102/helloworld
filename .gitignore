# ==========================================================
# Generated from ignore template repo (F:\DevProjects\repos\ignores)
# Sections: common + vscode + jetbrains + ai-agent (local state)
# Plus OpenWrt feed specific rules kept below.
# ==========================================================

# ---- common.gitignore ----

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
#
# ⚠️ `.env.*` 只适合没有"多模式 env 文件"惯例的技术栈（Go / Java / Python）。
#    前端框架（Vue CLI、Vite、CRA、Next）的 .env.<mode> 是构建期配置、惯例入库，
#    组合本片段时请改用 node/vue/react 片段里的 .env.local / .env.*.local 写法，
#    否则新增 mode 文件会被静默漏提交（老文件已跟踪、不报错，最难查）。
.env
.env.*
!.env.example
!.env.sample
*.local
*.secret
*.secrets
secrets/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
tmp/
temp/

# Archives and local dumps
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.dump
*.sql.gz

# ---- OpenWrt feed specific ----

# Build artifacts and package signing keys
*.o
key-build*
git-src

# Patch leftovers
/*.patch
*.orig
*.rej

# Eclipse / IDE local state
.project
.cproject
.ccache

# Editor backup files
.#*
*#
.emacs.desktop*
TAGS*~

# Local AI assistant instructions (not shared)
/.github/copilot-instructions.md

